<!-- 1. Navegação fixa com logo e links -->
<header class="navbar">
  <div class="logo">WebDesign Pro</div>
  <nav class="nav-links">
    <a href="#recursos">Recursos</a>
    <a href="#depoimentos">Depoimentos</a>
    <a href="#precos">Preços</a>
    <a href="#contato">Contato</a>
  </nav>
</header>

<!-- 2. Hero Section com headline, subheadline e 2 CTAs -->
<section class="hero">
  <div class="hero-content">
    <h1>Crie Interfaces Incríveis em Minutos</h1>
    <p>Aprenda web design prático focado em resultados rápidos e interfaces acessíveis.</p>
    <div class="hero-ctas">
      <a href="#precos" class="btn btn-primary">Começar Agora</a>
      <a href="#recursos" class="btn btn-secondary">Saber Mais</a>
    </div>
  </div>
</section>

<!-- 3. Seção de recursos com 3+ cards -->
<section id="recursos" class="section">
  <h2>Recursos Principais</h2>
  <div class="grid-3">
    <div class="card">
      <h3>Grid System</h3>
      <p>Layouts proporcionais e organizados com facilidade de alinhamento.</p>
    </div>
    <div class="card">
      <h3>Design Responsivo</h3>
      <p>Perfeita adaptação para celulares, tablets e telas de computador.</p>
    </div>
    <div class="card">
      <h3>Acessibilidade</h3>
      <p>Contraste adequado e navegação fluida para todas as pessoas.</p>
    </div>
  </div>
</section>

<!-- 4. Seção de depoimentos -->
<section id="depoimentos" class="section bg-alt">
  <h2>O que dizem os alunos</h2>
  <div class="grid-2">
    <div class="testimonial">
      <p>"O curso facilitou muito o entendimento das regras visuais!"</p>
      <strong>— Ana Silva</strong>
    </div>
    <div class="testimonial">
      <p>"A aplicação prática com código me deu muita segurança."</p>
      <strong>— Lucas Mendes</strong>
    </div>
  </div>
</section>

<!-- 5. Seção de preços (pricing) -->
<section id="precos" class="section">
  <h2>Planos de Acesso</h2>
  <div class="grid-2 pricing-grid">
    <div class="card pricing-card">
      <h3>Básico</h3>
      <p class="price">R$ 29/mês</p>
      <button class="btn btn-secondary btn-plan" data-plan="Básico">Assinar Básico</button>
    </div>
    <div class="card pricing-card featured">
      <h3>Pro</h3>
      <p class="price">R$ 59/mês</p>
      <button class="btn btn-primary btn-plan" data-plan="Pro">Assinar Pro</button>
    </div>
  </div>
</section>

<!-- 6. Formulário de contato/newsletter -->
<section id="contato" class="section bg-alt">
  <h2>Fique por Dentro</h2>
  <p>Receba novidades e dicas diretamente no seu e-mail.</p>
  <form class="newsletter-form" id="newsletterForm">
    <input type="email" id="emailInput" placeholder="Seu melhor e-mail" required>
    <button type="submit" class="btn btn-primary">Inscrever-se</button>
  </form>
  <p id="formFeedback" class="feedback-message"></p>
</section>

<!-- 7. Footer com links -->
<footer class="footer">
  <p>&copy; 2026 WebDesign Pro. Todos os direitos reservados.</p>
  <div class="footer-links">
    <a href="#">Termos</a>
    <a href="#">Privacidade</a>
  </div>
</footer>
